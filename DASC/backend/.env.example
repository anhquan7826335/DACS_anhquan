# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- MySQL ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=defaultdb
# true nếu dùng Aiven / MySQL cloud cần SSL (dùng CA trong src/certs/ca.pem)
DB_SSL=false

# Múi giờ dùng để xác định "hôm nay" khi đặt phòng theo ngày / hết hạn hợp đồng ngày
APP_TIMEZONE=Asia/Ho_Chi_Minh

# ---- Auth ----
JWT_SECRET=change_me
JWT_EXPIRES_IN=7d

# ---- Cloudinary ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- AI (ưu tiên Gemini, fallback OpenAI) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
OPENAI_API_KEY=
# Giới hạn token đầu ra của trợ lý hỗ trợ (mặc định 4096). Tăng nếu câu trả lời vẫn bị cắt giữa chừng.
AI_MAX_OUTPUT_TOKENS=4096

# ---- VietQR ----
VIETQR_BANK_CODE=
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=
VIETQR_TEMPLATE=compact2

# ---- Reminder cron ----
ENABLE_REMINDER_CRON=false
REMINDER_CRON_TIME=0 8 * * *
# BẮT BUỘC đặt để dùng 2 endpoint hệ thống-tới-hệ thống (bỏ trống -> endpoint trả 503)
CRON_SECRET=
BANK_WEBHOOK_SECRET=

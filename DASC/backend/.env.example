# ==== Server ====
PORT=5000
NODE_ENV=development

# ==== Database (MySQL 8.0+) ====
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=rental_management

# ==== JWT ====
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# ==== VietQR ====
# Xem danh sách mã ngân hàng: https://api.vietqr.io/v2/banks
VIETQR_BANK_CODE=970422        # VD: 970422 = MB Bank
VIETQR_ACCOUNT_NO=0123456789
VIETQR_ACCOUNT_NAME=NGUYEN VAN A
VIETQR_TEMPLATE=compact2

# ==== Cloudinary ====
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ==== AI Vision / OCR (chọn 1 hoặc cả 2, hệ thống ưu tiên Gemini nếu có) ====
GEMINI_API_KEY=
OPENAI_API_KEY=

# ==== Cron ====
ENABLE_REMINDER_CRON=true
REMINDER_CRON_TIME=0 8 * * *
CRON_SECRET=change_this_secret_for_trigger_reminders_endpoint

# ==== Bank Webhook (Auto-Matching gạch nợ tự động) ====
BANK_WEBHOOK_SECRET=change_this_secret_for_bank_webhook
